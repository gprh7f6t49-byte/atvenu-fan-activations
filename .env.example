# Copy to .env.local and fill in.

# Public URL of this app (used in emails and wallet passes). Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:3000

# First atVenu admin account (created on first start; afterwards manage the password in the app)
ADMIN_EMAIL=you@yourcompany.com
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional: a demo client login that owns the Oasis demo data (shows the client view)
# DEMO_CLIENT_EMAIL=demo@example.com
# DEMO_CLIENT_PASSWORD=change-me-too

# Optional: where the SQLite database lives (default ./data/activations.db)
# DATABASE_PATH=./data/activations.db

ORG_NAME=atVenu

# --- Email (optional; without it, emails are only saved to the admin outbox) ---
# Use ONE of: Postmark or Resend (HTTPS APIs, work on every Railway plan) or SMTP (blocked on Railway Trial/Hobby).
# EMAIL_FROM="Activations <passes@livetouch.app>"   # must be on a domain verified with the provider
# POSTMARK_SERVER_TOKEN=
# RESEND_API_KEY=
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# --- Apple Wallet (see certs/README.md) ---
# APPLE_PASS_TYPE_ID=pass.com.atvenu.activations
# APPLE_TEAM_ID=ABCDE12345
# APPLE_WWDR_CERT=./certs/wwdr.pem
# APPLE_SIGNER_CERT=./certs/signerCert.pem
# APPLE_SIGNER_KEY=./certs/signerKey.pem
# APPLE_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet ---
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_KEY_FILE=./certs/google-service-account.json
