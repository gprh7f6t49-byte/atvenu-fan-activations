# Copy to .env.local and fill in.

# Public URL of this app (used in emails and wallet passes). Must be https:// in production.
PUBLIC_BASE_URL=http://localhost:3000

# Admin sign-in
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Optional: where the SQLite database lives (default ./data/activations.db)
# DATABASE_PATH=./data/activations.db

ORG_NAME=atVenu

# --- Email (optional; without SMTP, emails are saved to the admin outbox) ---
# SMTP_HOST=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Oasis Fan Offers <offers@yourdomain.com>"

# --- Apple Wallet (see certs/README.md) ---
# APPLE_PASS_TYPE_ID=pass.com.atvenu.activations
# APPLE_TEAM_ID=ABCDE12345
# APPLE_WWDR_CERT=./certs/wwdr.pem
# APPLE_SIGNER_CERT=./certs/signerCert.pem
# APPLE_SIGNER_KEY=./certs/signerKey.pem
# APPLE_SIGNER_KEY_PASSPHRASE=

# --- Google Wallet ---
# GOOGLE_WALLET_ISSUER_ID=3388000000000000000
# GOOGLE_WALLET_KEY_FILE=./certs/google-service-account.json
